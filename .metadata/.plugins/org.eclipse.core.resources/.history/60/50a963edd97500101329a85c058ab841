#include "LIB/STD_TYPES.h"
#include "LIB/BIT_MATH.h"
#include "MCAL/TIMER1/TIMER1_interface.h"
#include "MCAL/EXTI/EXTI_interface.h"
#include "MCAL/EXTI/GI_interface.h"
#include "MCAL/DIO/DIO_interface.h"
#include "DOOR_interface.h"
#include "DOOR_config.h"
#include "DOOR_private.h"
#include "util/delay.h"
#define OCR1B       *((volatile u8*)0x4A)
volatile u8 mode = 1;

void Func(void)
{
    mode ^= 1;
    if (mode == 0)
    {
        Open_voidDoor();
    }
    else
    {
        Close_voidDoor();
    }
}

void Door_voidinit()
{
    TIMER1_voidInit_OC1B();  // New init for OC1B channel

    DIO_voidInit();
    DIO_u8SetPinDirection(DIO_u8_PORTB, DIO_u8_PIN2, DIO_u8_INPUT); // INT2 button
    DIO_u8SetPinValue(DIO_u8_PORTB, DIO_u8_PIN2, DIO_u8_HIGH);       // Pull-up

    DIO_u8SetPinDirection(DIO_u8_PORTD, DIO_u8_PIN4, DIO_u8_OUTPUT); // OC1B pin
    DIO_u8SetPinValue(DIO_u8_PORTD, DIO_u8_PIN4, DIO_u8_LOW);

    EXTI_voidEnableDisable(EXT_INT2, ENABLED);
    EXTI_voidSetSenseCtrl(EXT_INT2, FALLING_EDGE);
    EXTI_voidSetCallBack(EXT_INT2, Func);
    GI_voidEnable();
}

// ====== Timer1 Compare Set for OC1B ======
void TIMER1_voidSetCompareValue(u16 Copy_u16Value)
{
    OCR1B = Copy_u16Value;
}

// ====== Servo Angle Control ======
void Servo_voidSetAngle(u8 Copy_u8Angle)
{
    if (Copy_u8Angle > 180)
        Copy_u8Angle = 180;

    if (Copy_u8Angle == 0)
        TIMER1_voidSetCompareValue(1000);
    else if (Copy_u8Angle == 90)
        TIMER1_voidSetCompareValue(1500);
    else if (Copy_u8Angle == 180)
        TIMER1_voidSetCompareValue(2000);
}

// ====== Door Actions ======
void Open_voidDoor()
{
    Servo_voidSetAngle(180);
}

void Close_voidDoor()
{
    Servo_voidSetAngle(0);
}
