#include "LIB/STD_TYPES.h"
#include "HAL/SSD/HAL_SSD.h"
#include"avr/delay.h"

int main()
{


	while (1)
	    {
		   enable_ssd(DIO_u8_PORTA,DIO_u8_PIN7,CATHODE);
	        for (u8 i = 0; i < 10; i++)
	        {
	        	write_ssd(i);
	            _delay_ms(50);
	        }
	        disable_ssd(DIO_u8_PORTA,DIO_u8_PIN7,CATHODE);
	        _delay_ms(1000);
	    }

	return 0;
}
